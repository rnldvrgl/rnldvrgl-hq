# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Only the two NEXT_PUBLIC_ values are safe in the browser. Everything else is server-only.

# --- You ---
OWNER_EMAIL=delacruz.ronaldvergel@gmail.com
APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (main brain). Leave empty to run on the Gemini backup. ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Gemini API (free temporary backup, used only when ANTHROPIC_API_KEY is empty or rejected) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google may use free-tier prompts to improve its products. Keep false so Maya, Iggy and Dex
# (email, calendar, private repos) wait for Claude instead of sending your data to the backup.
BACKUP_ALLOW_PRIVATE=false

# --- Shared secret for the scheduler tick (openssl rand -hex 32) ---
CRON_SECRET=

# --- Shared secret for the iPhone Reminders Shortcut (openssl rand -hex 32). Different from CRON_SECRET. ---
SHORTCUTS_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=rnldvrgl HQ <onboarding@resend.dev>
EMAIL_TO=delacruz.ronaldvergel@gmail.com

# --- Google (Gmail + Calendar), your PERSONAL account ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- GitHub (fine-grained token, read-only) ---
GITHUB_TOKEN=
GITHUB_USERNAME=rnldvrgl
