# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Only the two NEXT_PUBLIC_ values are safe in the browser. Everything else is server-only.

# --- You ---
OWNER_EMAIL=delacruz.ronaldvergel@gmail.com
APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (main brain). Leave empty to run on the Gemini backup. ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Groq API (free backup, tried first when ANTHROPIC_API_KEY is empty or rejected) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Leave empty and HQ picks a working Groq model by itself (it tries several and remembers the first that works).
GROQ_MODEL=
# Optional, for Hunter and Rhea (web search): the compound models or gpt-oss with Groq's browser search.
# If your account has none of them, web searches go to the Gemini backup instead.
GROQ_SEARCH_MODEL=

# --- Gemini API (second free backup, used when Groq is missing or at its limit) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free tiers may use prompts to improve their products. Keep false so Maya, Iggy and Dex
# (email, calendar, private repos) wait for Claude instead of sending your data to a backup.
BACKUP_ALLOW_PRIVATE=false

# --- Shared secret for the scheduler tick (openssl rand -hex 32) ---
CRON_SECRET=

# --- Shared secret for the iPhone Reminders Shortcut (openssl rand -hex 32). Different from CRON_SECRET. ---
SHORTCUTS_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=rnldvrgl HQ <onboarding@resend.dev>
EMAIL_TO=delacruz.ronaldvergel@gmail.com

# --- Google (Gmail + Calendar), your PERSONAL account ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- GitHub (fine-grained token, read-only) ---
GITHUB_TOKEN=
GITHUB_USERNAME=rnldvrgl

# Push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto:you@example.com or your site URL
# Your contact, not a key: push services use it if they need to reach you. A mailto: address or your site URL.
VAPID_SUBJECT=mailto:delacruz.ronaldvergel@gmail.com
